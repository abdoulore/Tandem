# Finnhub API key: real-time US stock prices, the live reference for public stocks. Free key at https://finnhub.io
FINNHUB_API_KEY=

# Pyth Hermes API key (optional; used for any equity feeds the key is entitled to).
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# Solana mainnet RPC. The public endpoint works for demos; a Helius/Triton URL is more reliable.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter swap API. lite-api needs no key; set JUPITER_API_URL=https://api.jup.ag/swap/v1 plus a key for higher limits.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Keeper wallet (base58 secret key). Generate with: npm run keygen
KEEPER_SECRET_KEY=

# Telegram alerts (optional). Create a bot with @BotFather and paste its token; leave empty to turn alerts off.
TELEGRAM_BOT_TOKEN=
# Public address of the app, used in alert links.
APP_URL=https://tandem.moonrider.online

# Live orders above this many USD are refused.
MAX_LIVE_USD=250

# Platform fee on fair-price sells, in basis points, paid in USDC to FEE_OWNER. Off unless both are set.
# Create the fee owner's USDC account once with: npx tsx scripts/create-fee-account.ts --send
PLATFORM_FEE_BPS=0
FEE_OWNER=

# Global kill switch for real on-chain switches. Paper mode always works.
LIVE_EXECUTION=true
PORT=8787
